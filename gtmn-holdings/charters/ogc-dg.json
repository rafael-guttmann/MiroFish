  ],
  "veto": [
    {
      "ground": "the proposal cannot be done lawfully"
    },
    {
      "ground": "the instrument will not be enforceable as drafted"
    }
  ],
  "cannot_veto": [
    "whether the deal is worth doing",
    "price",
    "commercial terms within the law"
  ],
  "pen_default_for": [
    "instruments",
    "redlines",
    "disputes",
    "regulatory questions"
  ],
  "senior_panel": [
    "ogc-lipton",
    "ogc-laster",
    "ogc-white",
    "ogc-eizirik"
  ],
  "signoff_seat": "ogc-laster",
  "always_convened": [
    {
      "agent": "ogc-adams",
      "when": "any instrument is drafted or redlined (the language gate)"
    },
    {
      "agent": "ogc-kravitt",
      "when": "US origination and a Brazilian funding vehicle in the same mandate"
    }
  ],
  "dispatch": "parallel",
  "gates": [
    {
      "name": "Jurisdiction Gate, including the receivables branch",
      "approver": "seat",
      "defined_in": "SKILL.md"
    }
  ],
  "interaction": {
    "ask_via": "question_card",
    "default_if_unanswered": "use_recommended",
    "intake_questionnaire": "references/intake-router.md"
  },
  "outputs": [
    "md",
    "docx",
    "pdf"
  ],
  "notes": "Brazilian supersession rule applies. Max four practice groups per mandate on its own; the Plenary's seat cap governs on joint mandates."
}
